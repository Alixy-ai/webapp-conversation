# ---- Dify app credentials -------------------------------------------------
# On first start these are copied into the SQLite registry (data/apps.db) as the
# app served at /apps/<APP_SLUG>, which keeps single-app deployments working.
# Add more apps by inserting rows into the registry.

# APP ID: shown in the browser, safe to expose.
NEXT_PUBLIC_APP_ID=

# APP API key: server-side only, NEVER prefix it with NEXT_PUBLIC_.
APP_KEY=

# API base URL: server-side only. Dify cloud is https://api.dify.ai/v1.
API_URL=


# URL segment of the seeded app: /apps/<slug>. Defaults to `default`.
APP_SLUG=
# Display name of the seeded app. Defaults to APP_INFO.title in config/index.ts.
APP_NAME=
# Where the SQLite registry lives. Defaults to <cwd>/data/apps.db — point it at
# a mounted volume when running in Docker.
REGISTRY_DB_PATH=

# ---- Admin (optional) ------------------------------------------------------
# Login for /admin. Generate the hash with:
#   node scripts/hash-admin-password.mjs 'your-password'
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Plain text alternative to ADMIN_PASSWORD_HASH (less safe, hash is preferred).
ADMIN_PASSWORD=
# Optional: fixes the HMAC key used to sign session cookies.
ADMIN_SESSION_SECRET=
# Static token for scripts/CI hitting /api/admin/* (login session also works).
ADMIN_TOKEN=

# ---- AI generated notice (seeded into the registry on first start) ---------
# Whether seeded apps show an "AI generated" notice. Configurable per app in /admin.
AI_NOTICE_ENABLED=false
# Custom notice text (<= 200 characters); empty falls back to the built-in
# localised default shown to visitors.
AI_NOTICE_TEXT=
# Where the notice is shown: input_hint (below the input box) or answer_footer
# (below every answer).
AI_NOTICE_POSITION=input_hint
